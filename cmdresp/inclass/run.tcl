# run.tcl -- Vitis HLS C-simulation flow for the in-class scale-and-offset
# accelerator.  Per the in-class prompt this flow STOPS at C-simulation: there is
# no C-synthesis and no RTL co-simulation in this script.
#
# The kernel (gen/scale_offset.cpp) and the multi-activation testbench
# (gen/scale_offset_tb.cpp) are hand-written; the schema / array-utility headers
# under include/ are generated by scale_offset_build.py (HlsGenIncludeStep).
# The hand-written hook bodies live in scale_offset_{configure,transform,end}_
# impl.tpp at the source-tree root and are #include'd from gen/scale_offset.hpp.

open_project -reset waveflow_scale_proj
set_top scale_offset

add_files gen/scale_offset.cpp -cflags "-I."
add_files -tb gen/scale_offset_tb.cpp -cflags "-I."

set script_dir [file dirname [file normalize [info script]]]
set streamutils_cpp [file join $script_dir "streamutils.cpp"]
if {![file exists $streamutils_cpp]} {
    set streamutils_cpp [file join $script_dir "include" "streamutils.cpp"]
}
if {[file exists $streamutils_cpp]} {
    add_files -tb $streamutils_cpp
}

open_solution -reset "solution1"
set_part {xc7z020clg484-1}
set clk_period_ns 10
if {[info exists ::env(WAVEFLOW_SCALE_CLK_PERIOD_NS)]} {
    set clk_period_ns $::env(WAVEFLOW_SCALE_CLK_PERIOD_NS)
}
create_clock -period $clk_period_ns
set data_dir [file join $script_dir "data"]

if {[catch {csim_design -argv "$data_dir"} res]} {
    puts "WAVEFLOW_ERROR: scale_offset C-Simulation failed."
    puts $res
    exit 1
}

puts "WAVEFLOW_SUCCESS: scale_offset C-Simulation passed."
exit 0
