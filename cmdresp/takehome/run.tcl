# run.tcl -- Vitis HLS flow for the histogram accelerator (take-home).
#
# Three modes, selected by the WAVEFLOW_HIST_TB environment variable:
#
#   func (default) : the multi-activation functional testbench
#                    (gen/hist_tb.cpp, 21 scenarios).  C-sim writes its evidence
#                    to data/<name>/; when WAVEFLOW_HIST_COSIM=1 the same TB is
#                    RTL co-simulated and writes to results/vitis/cosim/<name>/.
#
#   tp             : the throughput testbench (gen/hist_tp_tb.cpp), one
#                    activation CONFIG(16,0,16)->DATA(N)->END, where N is read
#                    from <argv>/tp_nsamp.txt.  Used to measure the per-sample
#                    binning rate by difference (N=1 vs N=128) from the co-sim
#                    "Total Execution Time".
#
# The kernel (gen/hist.cpp) keeps its per-activation state LOCAL (re-created per
# ap_start) -- see the header comment in gen/hist.cpp.  The hand-written hook
# bodies live in hist_{configure,accumulate,emit}_impl.tpp at the source-tree
# root and are #include'd from gen/hist.hpp via "../<hook>_impl.tpp".
# The schema / array-utility headers under include/ are generated by
# hist_build.py (HlsGenIncludeStep).

open_project -reset waveflow_hist_proj
set_top hist
add_files gen/hist.cpp -cflags "-I."

set script_dir [file dirname [file normalize [info script]]]
set streamutils_cpp [file join $script_dir "streamutils.cpp"]
if {![file exists $streamutils_cpp]} {
    set streamutils_cpp [file join $script_dir "include" "streamutils.cpp"]
}
if {[file exists $streamutils_cpp]} {
    add_files -tb $streamutils_cpp
}

# Which testbench, and where C-sim / co-sim write their evidence.
set tb_mode "func"
if {[info exists ::env(WAVEFLOW_HIST_TB)]} {
    set tb_mode $::env(WAVEFLOW_HIST_TB)
}
if {$tb_mode eq "tp"} {
    set tb_file [file join $script_dir "gen" "hist_tp_tb.cpp"]
} else {
    set tb_mode "func"
    set tb_file [file join $script_dir "gen" "hist_tb.cpp"]
}
add_files -tb $tb_file -cflags "-I."

open_solution -reset "solution1"
set_part {xc7z020clg484-1}
set clk_period_ns 10
if {[info exists ::env(WAVEFLOW_HIST_CLK_PERIOD_NS)]} {
    set clk_period_ns $::env(WAVEFLOW_HIST_CLK_PERIOD_NS)
}
create_clock -period $clk_period_ns

# C-sim evidence always goes to data/ (the grader reads it from there).
set csim_dir [file join $script_dir "data"]
# Co-sim evidence goes to its own tree so it does not overwrite the C-sim
# evidence; both are kept and compared scenario-for-scenario.
if {$tb_mode eq "tp"} {
    set tp_nsamp 128
    if {[info exists ::env(WAVEFLOW_HIST_TP_NSAMP)]} {
        set tp_nsamp $::env(WAVEFLOW_HIST_TP_NSAMP)
    }
    set cosim_dir [file join $script_dir "results" "vitis" "tp_$tp_nsamp"]
} else {
    set cosim_dir [file join $script_dir "results" "vitis" "cosim"]
}

set do_cosim 0
set csim_only 0
set trace_level "none"
if {[info exists ::env(WAVEFLOW_HIST_COSIM)]} {
    set do_cosim [expr {$::env(WAVEFLOW_HIST_COSIM) in {1 true TRUE yes YES}}]
}
if {[info exists ::env(WAVEFLOW_HIST_CSIM_ONLY)]} {
    set csim_only [expr {$::env(WAVEFLOW_HIST_CSIM_ONLY) in {1 true TRUE yes YES}}]
}
if {[info exists ::env(WAVEFLOW_HIST_TRACE_LEVEL)]} {
    set trace_level $::env(WAVEFLOW_HIST_TRACE_LEVEL)
}
if {$trace_level ni {none port all}} {
    puts "WAVEFLOW_ERROR: Unsupported trace level '$trace_level'. Expected one of: none, port, all."
    exit 1
}

# Functional mode: C-sim first (evidence in data/), then -- if requested --
# C-synthesis + RTL co-sim (evidence in results/vitis/cosim/).
# WAVEFLOW_HIST_CSIM_ONLY=1 stops right after C-sim (no synthesis), so the pure
# C-sim step does not redundantly synthesize.
# Throughput mode: go straight to C-synthesis + RTL co-sim (one activation, N
# from tp_nsamp.txt); there is no separate C-sim evidence to produce.
if {$tb_mode eq "func"} {
    if {[catch {csim_design -argv "$csim_dir"} res]} {
        puts "WAVEFLOW_ERROR: hist C-Simulation failed."
        puts $res
        exit 1
    }
    if {$csim_only} {
        puts "WAVEFLOW_SUCCESS: hist C-Simulation passed."
        exit 0
    }
}

if {$do_cosim} {
    if {[catch {csynth_design} res]} {
        puts "WAVEFLOW_ERROR: hist C-Synthesis failed."
        puts $res
        exit 1
    }
    if {[catch {cosim_design -argv "$cosim_dir" -trace_level $trace_level} res]} {
        puts "WAVEFLOW_ERROR: hist RTL Co-Simulation failed."
        puts $res
        exit 1
    }
    puts "WAVEFLOW_SUCCESS: hist C-Synthesis and RTL Co-Simulation passed ($tb_mode)."
} else {
    if {[catch {csynth_design} res]} {
        puts "WAVEFLOW_ERROR: hist C-Synthesis failed."
        puts $res
        exit 1
    }
    puts "WAVEFLOW_SUCCESS: hist C-Simulation and C-Synthesis passed ($tb_mode)."
}
exit 0
